#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

VERSION="1.0.0"
BACKUP_ROOT="/var/backups/nova"
NOVA_DB="/var/lib/nova/nova.db"
LOCK_FILE="/run/lock/nova-migrate.lock"

log(){ printf '[nova-migrate] %s\n' "$*"; }
die(){ printf '[nova-migrate] ERROR: %s\n' "$*" >&2; exit 1; }
need_root(){ [[ $EUID -eq 0 ]] || die "Run as root."; }
need_cmd(){ command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }
deps(){ for c in tar sha256sum ssh scp rsync sqlite3 systemctl ss awk sed find sort; do need_cmd "$c"; done; }
lock(){ exec 9>"$LOCK_FILE"; flock -n 9 || die "Another nova-migrate operation is running."; }

timestamp(){ date '+%Y-%m-%d_%H-%M-%S'; }
latest_backup(){ find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*_*' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-; }

units(){
  systemctl list-units --all --no-legend --no-pager 2>/dev/null |
    awk '{print $1}' |
    grep -E '^(nova|nova-geo|xray|psiphon|sing-box|tor)([-@].*)?\.service$' |
    sort -u || true
}

copy_if_exists(){
  local src="$1" dst="$2"
  [[ -e "$src" ]] || return 0
  mkdir -p "$(dirname "$dst")"
  cp -a "$src" "$dst"
}

archive_if_dir(){
  local src="$1" out="$2"
  [[ -d "$src" ]] || return 0
  tar -C "$(dirname "$src")" -czf "$out" "$(basename "$src")"
}

backup(){
  need_root; deps; lock
  mkdir -p "$BACKUP_ROOT"
  local stamp dir tmp
  stamp="$(timestamp)"
  dir="$BACKUP_ROOT/$stamp"
  tmp="$dir.tmp"
  rm -rf "$tmp"; mkdir -p "$tmp"

  log "Creating backup: $dir"
  [[ -f "$NOVA_DB" ]] || die "Nova database not found: $NOVA_DB"

  local -a stop_units=()
  for u in $(units); do
    case "$u" in nova-agent.service|xray.service|psiphon.service|sing-box.service|tor.service) stop_units+=("$u");; esac
  done
  for u in "${stop_units[@]}"; do systemctl stop "$u" 2>/dev/null || true; done

  sqlite3 "$NOVA_DB" ".backup '$tmp/nova.db'"
  archive_if_dir "/var/lib/nova" "$tmp/var-lib-nova.tar.gz"
  archive_if_dir "/etc/nova" "$tmp/etc-nova.tar.gz"
  archive_if_dir "/usr/local/etc/xray" "$tmp/xray-config.tar.gz"
  archive_if_dir "/etc/psiphon" "$tmp/etc-psiphon.tar.gz"
  archive_if_dir "/etc/tor" "$tmp/etc-tor.tar.gz"
  archive_if_dir "/var/lib/tor" "$tmp/var-lib-tor.tar.gz"
  archive_if_dir "/etc/sing-box" "$tmp/etc-sing-box.tar.gz"
  archive_if_dir "/var/lib/sing-box" "$tmp/var-lib-sing-box.tar.gz"

  mkdir -p "$tmp/systemd"
  for u in $(units); do
    systemctl cat "$u" > "$tmp/systemd/$u" 2>/dev/null || true
    systemctl is-enabled "$u" > "$tmp/systemd/$u.enabled" 2>/dev/null || true
  done

  mkdir -p "$tmp/sysctl" "$tmp/etc-extra"
  for f in /etc/sysctl.d/99-nova-*.conf; do [[ -e "$f" ]] && cp -a "$f" "$tmp/sysctl/"; done
  copy_if_exists "/etc/logrotate.d/nova-access" "$tmp/etc-extra/nova-access"
  copy_if_exists "/etc/letsencrypt/renewal-hooks/deploy/nova-reload.sh" "$tmp/etc-extra/nova-reload.sh"

  systemctl list-unit-files --no-legend 2>/dev/null | awk '{print $1}' | grep -E '^(nova|nova-geo|xray|psiphon|sing-box|tor)([-@].*)?\.service$' | sort -u > "$tmp/service-units.txt" || true
  systemctl --no-pager --plain --type=service --all > "$tmp/services.txt" 2>&1 || true
  ss -lntp > "$tmp/listening-ports.txt" 2>&1 || true
  uname -a > "$tmp/kernel.txt"
  if command -v dpkg-query >/dev/null 2>&1; then
    dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null | grep -E '^(xray|sing-box|tor|sqlite3|rsync)' > "$tmp/package-versions.txt" || true
  fi

  cat > "$tmp/manifest.txt" <<EOF
nova-migrate version: $VERSION
created: $(date -Is)
hostname: $(hostname -f 2>/dev/null || hostname)
kernel: $(uname -r)
nova_db: $NOVA_DB
backup_root: $dir
NOTE: This archive contains credentials, keys and service configuration. Keep it private.
EOF

  mkdir -p "$dir"
  mv "$tmp"/* "$dir"/
  rmdir "$tmp"
  (cd "$dir" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS)
  chmod 600 "$dir"/* "$dir"/systemd/* "$dir"/sysctl/* "$dir"/etc-extra/* 2>/dev/null || true

  for u in "${stop_units[@]}"; do systemctl start "$u" 2>/dev/null || true; done

  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*_*' -mmin +10080 -exec rm -rf {} +
  log "Backup complete: $dir"
}

verify(){
  local dir="$1"
  [[ -d "$dir" && -f "$dir/SHA256SUMS" ]] || die "Invalid backup: $dir"
  (cd "$dir" && sha256sum -c SHA256SUMS)
}

restore(){
  need_root; deps; lock
  local dir="${1:-$(latest_backup)}"
  [[ -n "$dir" ]] || die "No backup found."
  verify "$dir"

  log "Creating emergency backup before restore..."
  local emergency="$BACKUP_ROOT/pre-restore-$(timestamp)"
  mkdir -p "$emergency"
  archive_if_dir "/var/lib/nova" "$emergency/var-lib-nova.tar.gz"
  archive_if_dir "/etc/nova" "$emergency/etc-nova.tar.gz"
  archive_if_dir "/usr/local/etc/xray" "$emergency/xray-config.tar.gz"

  log "Stopping Nova-related services..."
  for u in $(units); do systemctl stop "$u" 2>/dev/null || true; done

  archive_if_dir_restore(){
    local archive="$1"
    [[ -f "$archive" ]] || return 0
    tar -xzf "$archive" -C /
  }

  archive_if_dir_restore "$dir/var-lib-nova.tar.gz"
  archive_if_dir_restore "$dir/etc-nova.tar.gz"
  archive_if_dir_restore "$dir/xray-config.tar.gz"
  archive_if_dir_restore "$dir/etc-psiphon.tar.gz"
  archive_if_dir_restore "$dir/etc-tor.tar.gz"
  archive_if_dir_restore "$dir/var-lib-tor.tar.gz"
  archive_if_dir_restore "$dir/etc-sing-box.tar.gz"
  archive_if_dir_restore "$dir/var-lib-sing-box.tar.gz"

  if [[ -f "$dir/nova.db" ]]; then
    mkdir -p "$(dirname "$NOVA_DB")"
    cp -a "$dir/nova.db" "$NOVA_DB"
  fi

  if [[ -d "$dir/systemd" ]]; then
    for f in "$dir/systemd/"*.service; do
      [[ -f "$f" ]] || continue
      cp -a "$f" "/etc/systemd/system/$(basename "$f")"
    done
  fi
  if [[ -d "$dir/sysctl" ]]; then cp -a "$dir/sysctl/." /etc/sysctl.d/; fi
  if [[ -f "$dir/etc-extra/nova-access" ]]; then cp -a "$dir/etc-extra/nova-access" /etc/logrotate.d/nova-access; fi
  if [[ -f "$dir/etc-extra/nova-reload.sh" ]]; then
    mkdir -p /etc/letsencrypt/renewal-hooks/deploy
    cp -a "$dir/etc-extra/nova-reload.sh" /etc/letsencrypt/renewal-hooks/deploy/nova-reload.sh
    chmod +x /etc/letsencrypt/renewal-hooks/deploy/nova-reload.sh
  fi

  systemctl daemon-reload
  sysctl --system >/dev/null 2>&1 || true

  log "Restoring enabled states..."
  if [[ -d "$dir/systemd" ]]; then
    for f in "$dir/systemd/"*.service.enabled; do
      [[ -f "$f" ]] || continue
      u="$(basename "$f" .enabled)"
      state="$(head -1 "$f" || true)"
      case "$state" in
        enabled|enabled-runtime) systemctl enable "$u" 2>/dev/null || true ;;
        disabled|masked) systemctl disable "$u" 2>/dev/null || true ;;
      esac
    done
  fi

  log "Starting Nova-related services..."
  for u in $(units); do systemctl start "$u" 2>/dev/null || true; done
  sleep 2

  sqlite3 "$NOVA_DB" 'PRAGMA integrity_check;' | grep -qx 'ok' || die "SQLite integrity check failed."
  systemctl is-active --quiet nova-agent.service || die "nova-agent.service is not active."
  systemctl is-active --quiet xray.service || die "xray.service is not active."

  log "Restore complete."
  log "Listening ports:"
  ss -lntp | grep -E '(:443|:4430|:8088|:518|:844)' || true
}

migrate(){
  need_root; deps; lock
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: nova-migrate migrate root@SERVER_IP"
  backup
  local dir="$(latest_backup)"
  log "Sending backup to $target..."
  ssh "$target" 'mkdir -p /var/backups/nova'
  rsync -a --info=progress2 "$dir/" "$target:$dir/"
  scp "$0" "$target:/usr/local/sbin/nova-migrate"
  ssh "$target" "chmod +x /usr/local/sbin/nova-migrate && /usr/local/sbin/nova-migrate restore '$dir'"
  log "Migration finished."
}

list_backups(){
  need_root
  printf '%-24s %12s  %s\n' "DATE" "SIZE" "PATH"
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*_*' -print0 2>/dev/null |
    while IFS= read -r -d '' d; do
      printf '%-24s %12s  %s\n' "$(basename "$d")" "$(du -sh "$d" | awk '{print $1}')" "$d"
    done | sort -r
}

auto(){
  need_root; deps
  cat > /etc/systemd/system/nova-migrate-backup.service <<'EOF'
[Unit]
Description=Nova full backup
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nova-migrate backup
EOF
  cat > /etc/systemd/system/nova-migrate-backup.timer <<'EOF'
[Unit]
Description=Nova backup every 30 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now nova-migrate-backup.timer
  log "Automatic backup enabled: every 30 minutes, 7-day retention."
}

doctor(){
  need_root; deps
  echo "=== Nova Migrate $VERSION ==="
  echo "Hostname: $(hostname -f 2>/dev/null || hostname)"
  echo "Nova DB: $NOVA_DB"
  [[ -f "$NOVA_DB" ]] && sqlite3 "$NOVA_DB" 'PRAGMA integrity_check;'
  echo
  echo "=== Services ==="
  for u in $(units); do printf '%-45s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"; done
  echo
  echo "=== Listening ==="
  ss -lntp
}

usage(){
  cat <<EOF
Nova Migrate $VERSION

Usage:
  nova-migrate backup
  nova-migrate restore [BACKUP_DIR]
  nova-migrate migrate root@SERVER_IP
  nova-migrate list
  nova-migrate auto
  nova-migrate doctor
  nova-migrate version
  nova-migrate help

Examples:
  nova-migrate backup
  nova-migrate migrate root@45.135.194.195
  nova-migrate restore /var/backups/nova/2026-09-18_23-54-09
EOF
}

case "${1:-help}" in
  backup) backup ;;
  restore) restore "${2:-}" ;;
  migrate) migrate "${2:-}" ;;
  list) list_backups ;;
  auto) auto ;;
  doctor) doctor ;;
  version|-v|--version) echo "$VERSION" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
